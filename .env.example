# Copy to .env (gitignored) and fill in: cp .env.example .env
# Read by Docker Compose (env_file) and by the train/test/HPO scripts (uv run --env-file); never commit .env.

# Weights & Biases API key: https://wandb.ai/authorize (your account page shows it after login)
WANDB_API_KEY=

# Optional: W&B team or user to log to when logging.entity in the config is null
# WANDB_ENTITY=

# Optional: W&B server, only if you do not use the default host
# WANDB_BASE_URL=https://api.wandb.ai
